# 文件说明：统一Platform后端与知识模块的本机环境变量示例。
PLATFORM_APP_NAME=制度知识智能服务平台
PLATFORM_APP_VERSION=2.0.0-phase2
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8020
PLATFORM_RAG_DIAGNOSTICS_ENABLED=false

# Platform数据库和知识数据目录默认解析到项目var目录，通常无需覆盖。
# PLATFORM_DATABASE_URL=sqlite:///D:/2-code/policy-platform/var/platform.db
# PLATFORM_KNOWLEDGE_DATA_ROOT=D:/2-code/policy-platform/var/knowledge

# 进程内RAG直接使用以下Qdrant和模型服务，不再需要独立8010中转服务。
POLICY_QDRANT_URL=http://127.0.0.1:6333
POLICY_INDEX_PROFILE=policy_platform_dense

# 第二期认证与固定流程审核管理员。4A协议参数待单位规范确认后再增加。
PLATFORM_SESSION_TTL_HOURS=8
PLATFORM_COOKIE_SECURE=false
PLATFORM_PROCESS_REVIEWER_USER_ID=
POLICY_EMBEDDING_URL=http://10.9.7.1:8001/v1/embeddings
POLICY_EMBEDDING_MODEL=qwen3-embedding-4b
POLICY_EMBEDDING_REVISION=deployment-unreported
POLICY_EMBEDDING_DIMENSION=2560
# 默认优先LibreOffice Headless；未安装时在Windows回退到隐藏Word。
POLICY_DOCX_RENDER_ENGINE=auto_headless
# 服务器固定无界面渲染时设置为libreoffice，并可显式指定soffice路径。
# POLICY_LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
POLICY_RERANK_URL=http://10.9.7.1:8004/v1/rerank
POLICY_RERANK_MODEL=qwen3-reranker-4b
POLICY_GENERATOR_URL=http://10.9.7.1:8000/v1
POLICY_GENERATOR_MODEL=Qwen/Qwen3.8-27B

# 回答质量门禁默认关闭；设为true后启用回答覆盖和语义支撑校验。
POLICY_QUALITY_GATE_ENABLED=false

# 单Worker结构化事件日志；默认同时输出控制台和logs/worker.log。
PLATFORM_WORKER_LOG_LEVEL=INFO
# PLATFORM_WORKER_LOG_FILE=D:/2-code/policy-platform/logs/worker.log
PLATFORM_WORKER_LOG_MAX_BYTES=10485760
PLATFORM_WORKER_LOG_BACKUP_COUNT=5
