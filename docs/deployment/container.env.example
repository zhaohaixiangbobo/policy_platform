# 文件说明：生产Linux配置参考；P4使用prepare-compose.py生成隔离配置，见COMPOSE_LOCAL.md。
# 服务发现名称与Compose一致；模型地址由部署者填写，生产配置仍需P5核验。
PLATFORM_HOST=0.0.0.0
PLATFORM_PORT=8020
PLATFORM_DATABASE_URL=postgresql+psycopg://platform_app:CHANGE_ME@postgres:5432/platform
KNOWLEDGE_DATABASE_URL=postgresql+psycopg://knowledge_app:CHANGE_ME@postgres:5432/knowledge
POLICY_INDEX_PROFILE=policy_platform_production
POLICY_INDEX_ALIAS=policy_platform_production_active
POLICY_COLLECTION_PREFIX=policy_platform_production
PLATFORM_KNOWLEDGE_DATA_ROOT=/data/knowledge
PLATFORM_MATERIALS_ROOT=/data/materials
PLATFORM_WORKER_LOG_FILE=/data/logs/worker.log
PLATFORM_API_LOG_FILE=/data/logs/api.log
POLICY_DOCX_RENDER_ENGINE=libreoffice
POLICY_LIBREOFFICE_PATH=/usr/bin/soffice
POLICY_QDRANT_URL=http://qdrant:6333
POLICY_EMBEDDING_URL=http://MODEL_HOST:8001/v1/embeddings
POLICY_RERANK_URL=http://MODEL_HOST:8004/v1/rerank
POLICY_GENERATOR_URL=http://MODEL_HOST:8000/v1
PLATFORM_COOKIE_SECURE=true
