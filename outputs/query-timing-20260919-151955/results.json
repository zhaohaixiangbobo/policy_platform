    "request_id": "timing-3b9c62db328042c0ac23972b685320f0",
    "question": "行业级一等奖和省级一等奖的奖励标准一样吗？",
    "response": {
      "contract_version": "rag_api_v1_2",
      "request_id": "2912a432-226d-4ad9-8f85-5e4620b2102e",
      "status": "ANSWER",
      "answerable": true,
      "answer": "不一样。行业省级一类竞赛获得一等奖的个人一次性奖励不超过10000元；[E1]天津电网行业省级二类竞赛获得一等奖的个人一次性奖励不超过6000元。[E3]",
      "answerability": "SUFFICIENT",
      "reason_code": "COMPLETE",
      "missing_fields": [],
      "clarification_question": null,
      "citations": [
        {
          "citation_version": "citation_v1",
